# ---- 服务 ----
RAG_INTERNAL_TOKEN=dev-internal-token
RAG_PORT=8000

# ---- 向量库：milvus（生产）/ memory（本地无 Milvus 联调）----
RAG_VECTOR_STORE=milvus
RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=

# ---- SiliconFlow API（Embedding / Rerank 共用）----
RAG_SILICONFLOW_API_KEY=sk-your-siliconflow-key
RAG_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- Embedding：SiliconFlow Qwen3-Embedding ----
# 0.6B=1024维, 4B=2560维, 8B=4096维
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# ---- Reranker：SiliconFlow Qwen3-Reranker ----
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RAG_RERANKER_TOP_N=5

# ---- LLM（OpenAI 兼容协议）----
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_API_KEY=sk-xxxx
RAG_LLM_MODEL=deepseek-chat

# ---- 本地 vLLM 示例 ----
# RAG_LLM_BASE_URL=http://127.0.0.1:8080/v1
# RAG_LLM_API_KEY=EMPTY
# RAG_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
